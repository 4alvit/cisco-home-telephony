# REVIEW ONLY. Replace subnet after verifying the actual phone LAN.
# This adds a narrow INPUT guard; it does not replace existing firewall policy.
# Never flush ruleset on a k3s node. Apply/persist using the existing firewall owner.
# Do not allow TFTP ports outside a supervised maintenance window.
table inet cisco_voice_guard {
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr 192.168.50.0/24 udp dport { 5060, 10000-10199 } accept
    ip saddr 192.168.50.0/24 tcp dport 5060 accept
    # OPTIONAL HA: uncomment only with home_assistant.enabled and replace with
    # the actual source IP after routing/NAT. Never allow the whole LAN for AMI.
    # ip saddr 192.168.50.30 tcp dport 5038 accept
    tcp dport 5038 drop
    # If HA Assist is outside the phone LAN over a trusted private VPN, allow
    # only that HA IP to send SIP/RTP here, before the final UDP drop below.
    # ip saddr 10.50.0.30 udp dport { 5060, 10000-10199 } accept
    # TEMPORARY: remove these two lines after the provisioning window.
    ip saddr 192.168.50.0/24 udp dport { 69, 20000-20031 } accept
    udp dport { 69, 20000-20031 } drop
    # Both IPv4 and IPv6 traffic from every other source is denied.
    udp dport { 5060, 10000-10199 } drop
    tcp dport 5060 drop
  }
}
